	<connectionStrings>
	  <add name="SchoolContext"
		 providerName="System.Data.SqlClient"
		 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SchoolContext;Integrated Security=True;MultipleActiveResultSets=True" />
